<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">
    <persistence-unit name="labworkPU" transaction-type="JTA">
        <provider>org.eclipse.persistence.jpa.PersistenceProvider</provider>
        <jta-data-source>java:app/jdbc/labwork</jta-data-source>
        <class>ru.islab.labwork.entity.Location</class>
        <class>ru.islab.labwork.entity.Person</class>
        <class>ru.islab.labwork.entity.Coordinates</class>
        <class>ru.islab.labwork.entity.Discipline</class>
        <class>ru.islab.labwork.entity.LabWork</class>
        <class>ru.islab.labwork.entity.AppUser</class>
        <class>ru.islab.labwork.entity.UserSession</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>
        <shared-cache-mode>NONE</shared-cache-mode>
        <validation-mode>CALLBACK</validation-mode>
        <properties>
            <property name="eclipselink.target-database" value="PostgreSQL"/>
            <property name="eclipselink.weaving" value="false"/>
            <property name="eclipselink.logging.level" value="WARNING"/>
            <property name="eclipselink.ddl-generation" value="none"/>
        </properties>
    </persistence-unit>
</persistence>
